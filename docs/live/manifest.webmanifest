{
  "name": "Mirage Live",
  "short_name": "Mirage",
  "description": "Your phone lights up with the party.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
