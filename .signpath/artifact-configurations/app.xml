<?xml version="1.0" encoding="utf-8"?>
<!-- Mirage Overlay, step 1: every program file of the unpacked app (the GitHub artifact is a zip of overlay/dist/win-unpacked).
     Paste into SignPath → Project "mirage-overlay" → Artifact Configurations → slug "app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Mirage Overlay.exe" />
      <include path="resources/elevate.exe" />
      <include path="*.dll" min-matches="1" max-matches="unbounded" />
      <include path="**/*.node" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
